<svg xmlns="http://www.w3.org/2000/svg" width="600" height="450" viewBox="0 0 600 450">
  <defs>
    <linearGradient id="abg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a6b8a;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#0a2a3a;stop-opacity:1"/>
    </linearGradient>
  </defs>
  <rect width="600" height="450" fill="url(#abg)"/>
  <rect x="50" y="50" width="500" height="350" rx="10" fill="rgba(255,255,255,0.05)"/>
  <text x="300" y="200" font-family="Arial" font-size="80" fill="rgba(255,255,255,0.3)" text-anchor="middle">&#127758;</text>
  <text x="300" y="280" font-family="Arial" font-size="24" fill="rgba(255,255,255,0.5)" text-anchor="middle">About Our Travel Agency</text>
  <text x="300" y="320" font-family="Arial" font-size="16" fill="rgba(255,255,255,0.3)" text-anchor="middle">Explore · Discover · Travel</text>
</svg>
